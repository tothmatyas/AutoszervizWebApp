@page
@model AutoszervizWebApp.Pages.JavitasPages.EditModel

<h1>Javítás szerkesztése</h1>
<form method="post">
	<div asp-validation-summary="All" class="text-danger"></div>
	<input type="hidden" asp-for="Javitas.Id" />
	<input type="hidden" asp-for="Javitas.Allapot" />
	<input type="hidden" asp-for="Javitas.FelvetelDatuma" />

	<label asp-for="Javitas.UgyfelId">Ügyfél</label>
	<select asp-for="Javitas.UgyfelId" asp-items="Model.Ugyfelek" class="form-control"></select>
	<span asp-validation-for="Javitas.UgyfelId" class="text-danger"></span>

	<label asp-for="Javitas.Rendszam">Rendszám</label>
	<input asp-for="Javitas.Rendszam" class="form-control" />
	<span asp-validation-for="Javitas.Rendszam" class="text-danger"></span>

	<label asp-for="Javitas.Leiras">Leírás</label>
	<input asp-for="Javitas.Leiras" class="form-control" />
	<span asp-validation-for="Javitas.Leiras" class="text-danger"></span>

	<label asp-for="Javitas.Koltseg">Költség</label>
	<input asp-for="Javitas.Koltseg" class="form-control" />

	<p>Állapot: <strong>@Model.Javitas.Allapot</strong></p>
	<button type="submit" name="allapot" value="Felvéve" class="btn btn-secondary">Felvéve</button>
	<button type="submit" name="allapot" value="Folyamatban" class="btn btn-warning">Folyamatban</button>
	<button type="submit" name="allapot" value="Kész" class="btn btn-success">Kész</button>
	<button type="submit" class="btn btn-primary mt-3">Mentés</button>
</form>
<a asp-page="/UgyfelPages/Index">Vissza</a>
